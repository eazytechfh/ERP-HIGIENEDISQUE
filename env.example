# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Data provider mode: local | api
NEXT_PUBLIC_DATA_MODE=api

# Asaas (NFS-e) - somente servidor
# Sandbox: chave começa com $aact_hmlg_  |  Producao: $aact_prod_ (exige ASAAS_AMBIENTE=producao)
ASAAS_API_KEY=
# ASAAS_AMBIENTE=producao
# Token configurado no webhook de notas fiscais do Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=
